# ──────────────────────────────────────────────
# Privy (Authentication & Wallet)
# ──────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# ──────────────────────────────────────────────
# Supabase (Database & Session)
# ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ──────────────────────────────────────────────
# Blockchain (RPC + SBT Minting)
# ──────────────────────────────────────────────
NEXT_PUBLIC_AVALANCHE_FUJI_RPC_URL=your_rpc_url
NEXT_PUBLIC_PIMLICO_API_KEY=your_pimlico_api_key

# Server wallet that owns the ObeliskSBT contract and signs mint transactions.
# Generate with: cast wallet new  (Foundry) or any Ethereum wallet.
MINTER_PRIVATE_KEY=your_minter_wallet_private_key

# Deployed ObeliskSBT contract address on Avalanche Fuji.
# Populated automatically by: cd contracts && npm run deploy:fuji
SBT_CONTRACT_ADDRESS=

# For verifying contract on Snowtrace (optional).
SNOWTRACE_API_KEY=your_snowtrace_api_key

# ──────────────────────────────────────────────
# Admin
# ──────────────────────────────────────────────
# Shared secret for POST /api/admin/retry-sbt
ADMIN_SECRET=your_random_admin_secret
